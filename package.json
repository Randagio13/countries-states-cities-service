{
  "name": "countries-states-cities-service",
  "author": "Alessandro Casazza",
  "version": "1.4.2",
  "description": "Get the World's countries, states, regions and cities",
  "homepage": "https://github.com/Randagio13/countries-states-cities-service#readme",
  "bugs": {
    "url": "https://github.com/Randagio13/countries-states-cities-service/issues"
  },
  "repository": "https://github.com/Randagio13/countries-states-cities-service.git",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./cities": {
      "import": "./lib/cities.mjs",
      "require": "./lib/cities.cjs"
    },
    "./countries": {
      "import": "./lib/countries.mjs",
      "require": "./lib/countries.cjs"
    },
    "./states": {
      "import": "./lib/states.mjs",
      "require": "./lib/states.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "world",
    "countries",
    "states",
    "regions",
    "cities"
  ],
  "files": [
    "lib",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "tsdown",
    "start": "tsdown --watch",
    "check:exports": "pnpm build && attw --pack . --profile node16",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepare": "pnpm build",
    "optimize-data": "node scripts/optimize-data.js",
    "release": "lerna version --conventional-commits",
    "publish:from-git": "lerna publish from-git --yes"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@vitest/coverage-v8": "^4.1.10",
    "lerna": "^9.0.7",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
