{
  "name": "countries-states-cities-service",
  "author": "Alessandro Casazza",
  "version": "1.4.1",
  "description": "Get the World's countries, states, regions and cities",
  "homepage": "https://github.com/Randagio13/countries-states-cities-service#readme",
  "bugs": {
    "url": "https://github.com/Randagio13/countries-states-cities-service/issues"
  },
  "repository": "https://github.com/Randagio13/countries-states-cities-service.git",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./countries": {
      "import": {
        "types": "./lib/countries.d.ts",
        "default": "./lib/countries.js"
      },
      "require": {
        "types": "./lib/countries.d.cts",
        "default": "./lib/countries.cjs"
      }
    },
    "./states": {
      "import": {
        "types": "./lib/states.d.ts",
        "default": "./lib/states.js"
      },
      "require": {
        "types": "./lib/states.d.cts",
        "default": "./lib/states.cjs"
      }
    },
    "./cities": {
      "import": {
        "types": "./lib/cities.d.ts",
        "default": "./lib/cities.js"
      },
      "require": {
        "types": "./lib/cities.d.cts",
        "default": "./lib/cities.cjs"
      }
    }
  },
  "keywords": [
    "world",
    "countries",
    "states",
    "regions",
    "cities"
  ],
  "files": [
    "lib",
    "package.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "tsup",
    "start": "tsup --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepare": "pnpm build",
    "optimize-data": "node scripts/optimize-data.js",
    "release": "lerna version --conventional-commits",
    "publish:from-git": "lerna publish from-git --yes"
  },
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "lerna": "^9.0.7",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "yaml": "^2.9.0",
      "brace-expansion": "^5.0.6"
    }
  }
}
